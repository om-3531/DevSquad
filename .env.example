# DevSquad Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.

# Durable local storage for approval proposals. This path contains private
# candidate code and should be protected with normal host filesystem controls.
PROPOSAL_DB_PATH=backend/data/proposals.sqlite3

# Human Approval Authentication & Role-Based Authorization
# JSON-encoded mapping of Bearer tokens to subject identities and roles.
# Supported roles:
#   - "proposal_reviewer": can read proposals (GET /proposals/{id})
#   - "proposal_approver": can approve proposals (POST /proposals/{id}/approve)
# Tokens must be strong, high-entropy secrets provisioned out of band.
# Note: Static bearer tokens are for local/internal environments; production deployments
# should use an OIDC/OAuth-backed identity provider.
# APPROVAL_AUTH_TOKENS={"secret-reviewer-token-xyz":{"subject":"reviewer@devsquad.local","roles":["proposal_reviewer"]},"secret-approver-token-abc":{"subject":"lead@devsquad.local","roles":["proposal_reviewer","proposal_approver"]}}


# GitHub Integration
# Personal Access Token with repo scope (for reading issues and creating draft PRs)
GITHUB_TOKEN=your_github_personal_access_token_here

# Safety boundary: must remain false. This release has no write endpoint.
GITHUB_WRITES_ENABLED=false

# Default Target GitHub repository (format: owner/repo)
GITHUB_REPO=om-3531/DevSquad

# AI Agent Configuration (Groq API)
# Get your API key from https://console.groq.com
LLM_API_KEY=your_groq_api_key_here

# Primary LLM Model (e.g., openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile, qwen/qwen3.8-27b)
LLM_MODEL=openai/gpt-oss-120b

# Fallback LLM Model (recommended when primary model hits rate limits)
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional Role-Specific Models (override LLM_MODEL for specific agents)
# LLM_MODEL_PLANNER=openai/gpt-oss-20b
# LLM_MODEL_CODER=openai/gpt-oss-120b
# LLM_MODEL_TESTER=openai/gpt-oss-20b
# LLM_MODEL_REVIEWER=openai/gpt-oss-20b
