FROM python:3.12-slim

# Approved candidate dependencies for isolated test execution
COPY candidate-requirements.txt /tmp/candidate-requirements.txt
RUN pip install --no-cache-dir -r /tmp/candidate-requirements.txt \
    && rm /tmp/candidate-requirements.txt

RUN useradd --create-home --uid 10001 runner \
    && mkdir -p /workspace \
    && chown runner:runner /workspace

WORKDIR /workspace

USER 10001:10001

CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
